---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
    <button
      class="navigation-mode-toggle print:hidden"
      type="button"
      aria-label="Compact navigation"
      aria-pressed="false"
      title="Use compact navigation"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <path d="M9 4v16M6.5 10 4.5 12l2 2" />
      </svg>
    </button>
  </div>
  <div class="sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <label class="translate-select" style="--sl-select-width: 6.25em">
      <span class="sr-only">Translate page language</span>
      <svg
        aria-hidden="true"
        class="icon label-icon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path
          fill-rule="evenodd"
          d="M8.516 3a.94.94 0 0 0-.941.94v1.15H2.94a.94.94 0 1 0 0 1.882h7.362a7.422 7.422 0 0 1-1.787 3.958 7.42 7.42 0 0 1-1.422-2.425.94.94 0 1 0-1.774.627 9.303 9.303 0 0 0 1.785 3.043 7.422 7.422 0 0 1-4.164 1.278.94.94 0 1 0 0 1.881 9.303 9.303 0 0 0 5.575-1.855 9.303 9.303 0 0 0 4.11 1.74l-.763 1.525a.968.968 0 0 0-.016.034l-1.385 2.77a.94.94 0 1 0 1.683.841l1.133-2.267h5.806l1.134 2.267a.94.94 0 0 0 1.683-.841l-1.385-2.769a.95.95 0 0 0-.018-.036l-3.476-6.951a.94.94 0 0 0-1.682 0l-1.82 3.639a7.423 7.423 0 0 1-3.593-1.256 9.303 9.303 0 0 0 2.27-5.203h1.894a.94.94 0 0 0 0-1.881H9.456V3.94A.94.94 0 0 0 8.516 3Zm6.426 11.794a1.068 1.068 0 0 1-.02.039l-.703 1.407h3.924l-1.962-3.924-1.24 2.478Z"
          clip-rule="evenodd"
        />
      </svg>
      <select id="translate-language-select" autocomplete="off">
        <option value="english" selected>English</option>
        <option value="chinese_simplified">简体中文</option>
      </select>
      <svg
        aria-hidden="true"
        class="icon caret"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path
          d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z"
        />
      </svg>
    </label>
    <LanguageSelect />
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      align-items: center;
      gap: 0.75rem;
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
    }

    .navigation-mode-toggle {
      display: none;
      place-items: center;
      flex: none;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid transparent;
      border-radius: 6px;
      padding: 0;
      color: var(--sl-color-gray-3);
      background: transparent;
      cursor: pointer;
    }

    .navigation-mode-toggle svg {
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.8;
    }

    .navigation-mode-toggle:hover {
      border-color: var(--sl-color-gray-5);
      color: var(--sl-color-white);
      background: var(--sl-color-gray-6);
    }

    .navigation-mode-toggle:focus-visible {
      outline: 2px solid var(--sl-color-text-accent);
      outline-offset: 2px;
    }

    .navigation-mode-toggle[aria-pressed='true'] {
      border-color: color-mix(in srgb, var(--sl-color-text-accent), transparent 55%);
      color: var(--sl-color-text-accent);
      background: color-mix(in srgb, var(--sl-color-text-accent), transparent 90%);
    }

    .navigation-mode-toggle[aria-pressed='true'] svg {
      transform: scaleX(-1);
    }

    /* translate.js language switcher, styled to match the Starlight Select (theme/language pickers) */
    .translate-select {
      --sl-label-icon-size: 0.875rem;
      --sl-caret-size: 1.25rem;
      --sl-inline-padding: 0.5rem;
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.25rem;
      color: var(--sl-color-gray-2);
    }

    .translate-select:hover {
      color: var(--sl-color-white);
    }

    .translate-select .icon {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
    }

    .translate-select .label-icon {
      font-size: var(--sl-label-icon-size);
      inset-inline-start: 0;
    }

    .translate-select .caret {
      font-size: var(--sl-caret-size);
      inset-inline-end: 0;
    }

    .translate-select select {
      border: 0;
      padding-block: 0.625rem;
      padding-inline: calc(var(--sl-label-icon-size) + var(--sl-inline-padding) + 0.25rem)
        calc(var(--sl-caret-size) + var(--sl-inline-padding) + 0.25rem);
      margin-inline: calc(var(--sl-inline-padding) * -1);
      width: calc(var(--sl-select-width) + var(--sl-inline-padding) * 2);
      background-color: transparent;
      text-overflow: ellipsis;
      color: inherit;
      cursor: pointer;
      appearance: none;
    }

    .translate-select option {
      background-color: var(--sl-color-bg-nav);
      color: var(--sl-color-gray-1);
    }

    @media (min-width: 50rem) {
      .translate-select select {
        font-size: var(--sl-text-sm);
      }
    }

    .right-group,
    .social-icons {
      gap: 1rem;
      align-items: center;
    }

    .social-icons::after {
      content: '';
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }

    @media (min-width: 50rem) {
      :global(:root[data-has-sidebar]) {
        --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
      }

      :global(:root:not([data-has-toc])) {
        --__toc-width: 0rem;
      }

      .header {
        --__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
        --__main-column-fr: calc(
          (
              100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
                (2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
                var(--sl-content-width)
            ) / 2
        );
        display: grid;
        grid-template-columns:
          minmax(
            calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
            auto
          )
          1fr
          auto;
        align-content: center;
      }

      .navigation-mode-toggle {
        display: grid;
      }
    }
  }
</style>

<script>
  const translateSelect = document.getElementById('translate-language-select') as
    | HTMLSelectElement
    | null;
  const translate = (window as { translate?: any }).translate;

  translateSelect?.addEventListener('change', () => {
    if (!translate) return;
    try {
      if (translateSelect.value === 'english') translate.reset();
      else translate.changeLanguage(translateSelect.value);
    } catch (error) {
      console.error('translate.js toggle failed', error);
    }
  });

  // Re-apply a previously chosen language (translate.js persists the choice per domain)
  const cached = translate?.storage?.get?.('to');
  if (cached && cached !== 'english' && translateSelect) {
    translateSelect.value = cached;
    translate.execute();
  }
</script>
